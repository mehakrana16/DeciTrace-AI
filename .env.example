# ---------------------------------------------------------------------------
# DeciTrace AI — environment template
# Copy to `.env` at the repository root and adjust as needed.
#   cp .env.example .env
# Nothing here is required: every value has a working default, and the app
# runs fully in deterministic mode with NO API key at all.
# ---------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# SQLite (default, zero configuration):
DECITRACE_DATA_DIR=./data
DATABASE_URL=sqlite:///./data/decitrace.db
# PostgreSQL alternative (comment SQLite out and use this instead):
# DATABASE_URL=postgresql+psycopg2://decitrace:decitrace@localhost:5432/decitrace

# --- Retrieval / RAG ---------------------------------------------------------
# auto | sentence-transformers | tfidf
# `auto` uses Sentence Transformers when the model is available locally and
# otherwise falls back to a deterministic local TF-IDF embedding model.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto | faiss | numpy
VECTOR_BACKEND=auto
RAG_TOP_K=5
RAG_MIN_SCORE=0.05

# --- LLM (OPTIONAL) ----------------------------------------------------------
# Leave LLM_API_KEY empty to run in deterministic template mode.
# The application NEVER fabricates metrics with or without an LLM.
LLM_PROVIDER=auto            # auto | openai | gemini | ollama | none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=25

# --- Decision engine thresholds ---------------------------------------------
PRIORITY_HIGH_THRESHOLD=55
PRIORITY_MEDIUM_THRESHOLD=32

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
